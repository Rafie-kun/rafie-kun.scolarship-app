# GEMINI_API_KEY: Required for admissions panel review evaluations and Wise Librarian chats.
GEMINI_API_KEY=

# JWT_SECRET: REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ADMIN_TOKEN: Authentication token for running the high-privilege administrative
# university import (sent via the x-admin-token header). Generate a unique random value.
ADMIN_TOKEN=

# GEMINI_MODEL: Optional model override (default gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# VAPID keys for PWA push (generate via: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# TURSO (for Vercel persistence, optional):
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

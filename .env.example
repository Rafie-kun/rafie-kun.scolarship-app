# Somnia — environment variables (names only; values never committed)
# Copy to .env and fill in values before local/dev runs.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scholarpath?pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/scholarpath"

# --- Auth (Auth.js v5 / NextAuth) ---
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (transactional provider) ---
EMAIL_SERVER=""
RESEND_API_KEY=""
EMAIL_FROM=""

# --- Storage (private S3-compatible bucket) ---
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- AI (server-only; never in client bundle) ---
GEMINI_API_KEY=""
AI_MODEL="gemini-3.6-flash"

# --- FX (currency conversion, server-only) ---
FX_PROVIDER=""
FX_API_KEY=""

# --- Rate limiting (durable store) ---
RATE_LIMIT_REDIS_URL=""
RATE_LIMIT_REDIS_TOKEN=""

# --- Jobs / cron (secured) ---
CRON_SECRET=""

# --- Admin bootstrap ---
ADMIN_BOOTSTRAP_EMAIL=""

# --- Public (only var allowed with NEXT_PREFIX) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional ---
SENTRY_DSN=""

# GEMINI_API_KEY: Required for admissions panel review evaluations and Wise Librarian chats.
GEMINI_API_KEY=

# JWT_SECRET: REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ADMIN_TOKEN: Authentication token for running the high-privilege administrative
# university import (sent via the x-admin-token header). Generate a unique random value.
ADMIN_TOKEN=

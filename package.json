{
  "name": "scholarpath-app",
  "version": "4.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/copy-data.js",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "tauri": "tauri",
    "electron": "electron .",
    "electron:build": "electron-builder --win --publish never",
    "electron:build:win": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.rafiekun.scholarpath.beta",
    "productName": "ScholarPath Beta",
    "files": ["dist/**/*", "electron/**/*"],
    "directories": { "buildResources": "public" },
    "win": { "target": "nsis", "icon": "public/favicon.svg" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false }
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "express": "^4.19.2",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.435.0",
    "motion": "^11.11.17",
    "node-cron": "^4.4.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "recharts": "^3.9.1",
    "rss-parser": "^3.13.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0-beta.8",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vite": "^6.0.0"
  }
}
